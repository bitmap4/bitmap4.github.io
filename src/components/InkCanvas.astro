---
/**
 * Generative ink-flow canvas — the hero focal point.
 * Draws organic, flowing ink strokes that animate continuously
 * and respond subtly to mouse movement.
 */
---

<div class="ink-canvas-wrap">
  <svg style="position: absolute; width: 0; height: 0;" aria-hidden="true">
    <filter id="rough-ink">
      <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="3" result="noise" />
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="12" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>
  <canvas id="ink-canvas" aria-hidden="true"></canvas>
</div>

<style>
  .ink-canvas-wrap {
    position: absolute;
    inset: -20px -20px -20px 20%;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    mask-image: radial-gradient(ellipse 45% 45% at 50% 50%, black 10%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 45% 45% at 50% 50%, black 10%, transparent 100%);
  }

  #ink-canvas {
    width: 100%;
    height: 100%;
    display: block;
    mix-blend-mode: multiply;
    filter: url(#rough-ink);
    opacity: 0.85;
  }
</style>

<script>
  const canvas = document.getElementById('ink-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  let width: number, height: number;
  let dpr = Math.min(window.devicePixelRatio || 1, 2);

  function resize() {
    const rect = canvas.parentElement!.getBoundingClientRect();
    width = rect.width;
    height = rect.height;
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = width * dpr;
    canvas.height = height * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  class InkStroke {
    points: { x: number; y: number; vx: number; vy: number }[];
    color: string;
    baseWidth: number;
    noiseOffset: number;
    speed: number;
    wander: number;

    constructor() {
      this.points = [];
      const startX = width * (0.25 + Math.random() * 0.65);
      const startY = height * (0.05 + Math.random() * 0.9);
      const spread = 100 + Math.random() * 200;

      const numPoints = 10 + Math.floor(Math.random() * 11);
      for (let i = 0; i < numPoints; i++) {
        const angle = Math.random() * Math.PI * 2;
        const dist = Math.random() * spread;
        this.points.push({
          x: startX + Math.cos(angle) * dist + (Math.random() - 0.5) * 60,
          y: startY + Math.sin(angle) * dist * 0.6 + (i / numPoints) * 80,
          vx: (Math.random() - 0.5) * 0.4,
          vy: (Math.random() - 0.5) * 0.4,
        });
      }

      const colors = [
        'rgba(28, 25, 23, 0.18)', 'rgba(28, 25, 23, 0.14)', 'rgba(28, 25, 23, 0.12)',
        'rgba(87, 83, 78, 0.13)', 'rgba(158, 59, 45, 0.10)', 'rgba(158, 59, 45, 0.08)',
        'rgba(120, 113, 108, 0.11)', 'rgba(28, 25, 23, 0.20)'
      ];
      this.color = colors[Math.floor(Math.random() * colors.length)];
      this.baseWidth = 1 + Math.random() * 4;
      this.noiseOffset = Math.random() * 1000;
      this.speed = 0.08 + Math.random() * 0.2;
      this.wander = 0.5 + Math.random() * 1.2;
    }

    update(t: number) {
      for (const p of this.points) {
        const nx = Math.sin(t * this.speed + p.y * 0.004 + this.noiseOffset) * this.wander;
        const ny = Math.cos(t * this.speed + p.x * 0.004 + this.noiseOffset + 1.5) * this.wander;
        p.vx += (nx - p.vx) * 0.015;
        p.vy += (ny - p.vy) * 0.015;
        p.x += p.vx;
        p.y += p.vy;

        // soft spring boundary: gently pull them back if they drift too far out
        if (p.x < -100) p.vx += (-100 - p.x) * 0.0005;
        if (p.x > width + 100) p.vx -= (p.x - (width + 100)) * 0.0005;
        if (p.y < -100) p.vy += (-100 - p.y) * 0.0005;
        if (p.y > height + 100) p.vy -= (p.y - (height + 100)) * 0.0005;
      }

      for (let i = 1; i < this.points.length - 1; i++) {
        const p = this.points[i];
        const prev = this.points[i - 1];
        const next = this.points[i + 1];
        const targetVx = (prev.vx + next.vx) / 2;
        const targetVy = (prev.vy + next.vy) / 2;
        p.vx += (targetVx - p.vx) * 0.08;
        p.vy += (targetVy - p.vy) * 0.08;
      }

      for (let iter = 0; iter < 2; iter++) {
        for (let i = 0; i < this.points.length - 1; i++) {
          const p1 = this.points[i];
          const p2 = this.points[i + 1];
          const dx = p2.x - p1.x;
          const dy = p2.y - p1.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist > 0) {
            const diff = (dist - 40) / dist * 0.5; 
            p1.x += dx * diff;
            p1.y += dy * diff;
            p2.x -= dx * diff;
            p2.y -= dy * diff;
          }
        }
      }
    }

    draw(t: number) {
      if (this.points.length < 3) return;
      const pts = this.points;

      ctx.beginPath();
      ctx.strokeStyle = this.color;
      ctx.moveTo(pts[0].x, pts[0].y);

      for (let i = 1; i < pts.length - 1; i++) {
        const xc = (pts[i].x + pts[i + 1].x) / 2;
        const yc = (pts[i].y + pts[i + 1].y) / 2;
        ctx.quadraticCurveTo(pts[i].x, pts[i].y, xc, yc);
      }

      const last = pts[pts.length - 1];
      ctx.lineTo(last.x, last.y);

      const w = this.baseWidth + Math.sin(t * 0.25 + this.noiseOffset) * 1.5;
      ctx.lineWidth = Math.max(0.5, w);
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.stroke();
    }
  }

  interface InkDot {
    x: number;
    y: number;
    r: number;
    opacity: number;
  }

  let strokes: InkStroke[] = [];
  let dots: InkDot[] = [];

  function drawDots() {
    for (const d of dots) {
      ctx.beginPath();
      ctx.arc(d.x, d.y, d.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(28, 25, 23, ${d.opacity})`;
      ctx.fill();
    }
  }

  function init() {
    resize();
    strokes = [];
    dots = [];

    const strokeCount = 30 + Math.floor(Math.random() * 11);
    for (let i = 0; i < strokeCount; i++) {
      strokes.push(new InkStroke());
    }

    const dotCount = 20 + Math.floor(Math.random() * 21);
    for (let i = 0; i < dotCount; i++) {
      dots.push({
        x: width * (0.1 + Math.random() * 0.85),
        y: Math.random() * height,
        r: 1.5 + Math.random() * 4,
        opacity: 0.3 + Math.random() * 0.2
      });
    }

    // Pre-simulate physics to generate stable, smooth, organic curves
    const PRE_SIM_STEPS = 400;
    for (let i = 0; i < PRE_SIM_STEPS; i++) {
      const t = i * 0.016;
      for (const s of strokes) {
        s.update(t);
      }
    }

    // Draw exactly once
    ctx.clearRect(0, 0, width, height);
    for (const s of strokes) {
      s.draw(PRE_SIM_STEPS * 0.016);
    }
    drawDots();
  }

  // Use IntersectionObserver or a simple initial call + resize
  init();

  window.addEventListener('resize', () => { init(); });
</script>
