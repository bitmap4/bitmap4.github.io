---
/**
 * Inline SVG icon component.
 * Usage: <Icon name="external" /> or <Icon name="arrow-left" />
 */
interface Props {
  name: 'external' | 'arrow-left' | 'arrow-right' | 'github' | 'mail' | 'calendar';
  size?: number;
}

const { name, size = 14 } = Astro.props;
---

{name === 'external' && (
  <svg class="icon" width={size} height={size} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M6.5 3.5h-3a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-3" />
    <path d="M10 2.5h3.5v3.5" />
    <path d="M7.5 8.5 13.5 2.5" />
  </svg>
)}

{name === 'arrow-left' && (
  <svg class="icon" width={size} height={size} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M10 3 5 8l5 5" />
  </svg>
)}

{name === 'arrow-right' && (
  <svg class="icon" width={size} height={size} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M6 3l5 5-5 5" />
  </svg>
)}

{name === 'github' && (
  <svg class="icon" width={size} height={size} viewBox="0 0 16 16" fill="currentColor">
    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
  </svg>
)}

{name === 'mail' && (
  <svg class="icon" width={size} height={size} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <rect x="1.5" y="3" width="13" height="10" rx="1" />
    <path d="M1.5 4.5 8 9l6.5-4.5" />
  </svg>
)}

{name === 'calendar' && (
  <svg class="icon" width={size} height={size} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <rect x="2" y="3" width="12" height="11" rx="1" />
    <path d="M5 1v3M11 1v3M2 7h12" />
  </svg>
)}

<style>
  .icon {
    display: inline-block;
    vertical-align: -0.1em;
    flex-shrink: 0;
  }
</style>
