---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ExtLink from '../components/ExtLink.astro';
---

<Base title="Misc — Abhyudit Singh" description="Clubs, competitions, and other things">
  <div class="page-header">
    <h1 class="page-header__title">Miscellaneous</h1>
    <p class="page-header__desc">Clubs, competitions, and everything else.</p>
  </div>

  <section class="misc-section">
    <h2 class="misc-section__title">Clubs</h2>

    <div class="misc-item">
      <div class="misc-item__title">Game Theory Club — Website Development</div>
      <p class="misc-item__desc">
        Built and deployed the official website for the Game Theory club at IIIT Hyderabad using Next.js.
        <ExtLink href="https://gametheory-iiith.github.io">Website</ExtLink>
        ·
        <ExtLink href="https://github.com/gametheory-iiith/gametheory-iiith.github.io">GitHub</ExtLink>
      </p>
    </div>

    <div class="misc-item">
      <div class="misc-item__title">0x1337 — The Hacking Club</div>
      <p class="misc-item__desc">
        Deccan CTF problem setter and organiser (2024, 2025).
      </p>
    </div>
  </section>

  <section class="misc-section">
    <h2 class="misc-section__title">Competitive Programming</h2>

    <div class="misc-item">
      <div class="misc-item__title">Codeforces</div>
      <p class="misc-item__desc">
        Rated 1608. <ExtLink href="https://codeforces.com/profile/BitMap4">Profile</ExtLink>
      </p>
    </div>

    <div class="misc-item">
      <div class="misc-item__title">Advent of Code 2024</div>
      <p class="misc-item__desc">
        Completed all 25 days.
        <ExtLink href="https://github.com/bitmap4/aoc-2024">Solutions</ExtLink>
      </p>
    </div>

    <div class="misc-item">
      <div class="misc-item__title">Advent of Code 2025</div>
      <p class="misc-item__desc">
        In progress.
        <ExtLink href="https://github.com/bitmap4/aoc-2025">Solutions</ExtLink>
      </p>
    </div>
  </section>
</Base>
