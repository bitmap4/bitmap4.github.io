---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Research — Abhyudit Singh" description="Research projects and ongoing work">
  <div class="page-header">
    <h1 class="page-header__title">Research</h1>
    <p class="page-header__desc">Things I'm investigating.</p>
  </div>
  <div class="project-list">
    {research.map((r) => (
      <ProjectCard
        title={r.data.title}
        description={r.data.description}
        tech={r.data.tech}
        href={`/research/${r.id.replace(/\.md$/, '')}`}
      />
    ))}
  </div>
</Base>
